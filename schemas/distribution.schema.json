{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecl:schema:self-contained-distribution",
  "title": "Self-contained ECL redistribution identity envelope",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "bundle",
    "operative",
    "bundle_manifest",
    "license",
    "schedule",
    "notice"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "ecl-self-contained-redistribution-v1"},
    "bundle": {
      "type": "string",
      "pattern": "^(?:ECL-[0-9]+\\.[0-9]+\\.[0-9]+@RP-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[0-9]+)?|ECL-0\\.3-DRAFT@RP-EMPTY-1)$"
    },
    "operative": {"type": "boolean"},
    "bundle_manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "ECL-BUNDLE.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "license": {
      "allOf": [
        {"$ref": "#/$defs/localComponent"},
        {
          "properties": {
            "ref": {
              "pattern": "^(?:ECL-[0-9]+\\.[0-9]+\\.[0-9]+|ECL-0\\.3-DRAFT)$"
            },
            "path": {"const": "LICENSE"}
          }
        }
      ]
    },
    "schedule": {
      "allOf": [
        {"$ref": "#/$defs/localComponent"},
        {
          "properties": {
            "ref": {
              "pattern": "^ECL-RP-(?:[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[0-9]+)?|EMPTY-1)$"
            },
            "path": {"const": "ECL-SCHEDULE"}
          }
        }
      ]
    },
    "notice": {
      "const": "PACKAGING INTEGRITY ONLY. Verification of this envelope does not constitute legal advice, a qualified legal review, or a determination of ECL compliance."
    }
  },
  "$defs": {
    "localComponent": {
      "type": "object",
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
