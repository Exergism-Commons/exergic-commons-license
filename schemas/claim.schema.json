{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecl/schemas/claim.schema.json",
  "title": "ECL atomic evidence claim",
  "type": "object",
  "required": ["id", "subject", "predicate", "status", "confidence", "evidence"],
  "properties": {
    "@context": {"type": "string"},
    "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$"},
    "subject": {"type": "string"},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": ["string", "null"]},
    "literalValue": {},
    "status": {"enum": ["candidate", "accepted", "disputed", "rejected", "superseded"]},
    "confidence": {"enum": ["established", "well-supported", "reasonable-inference", "disputed", "insufficient", "rejected"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": ["string", "null"], "format": "date"},
    "validTo": {"type": ["string", "null"], "format": "date"},
    "supportsVariables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variable", "direction"],
        "properties": {
          "variable": {"enum": ["P", "A", "V_ep", "L", "O", "U", "C", "S", "R", "Ecol"]},
          "direction": {"enum": ["up", "down", "mixed", "unknown"]},
          "rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "affectedCriteria": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidenceId", "locator", "grade", "stance"],
        "properties": {
          "evidenceId": {"type": "string"},
          "publisher": {"type": "string"},
          "title": {"type": "string"},
          "locator": {"type": "string"},
          "publicationDate": {"type": ["string", "null"], "format": "date"},
          "retrievedAt": {"type": ["string", "null"], "format": "date-time"},
          "contentHash": {"type": ["string", "null"]},
          "grade": {"enum": ["E0", "E1", "E2", "E3"]},
          "stance": {"enum": ["supports", "contradicts", "context"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
