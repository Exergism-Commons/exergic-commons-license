{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecl/schemas/claim.schema.json",
  "title": "ECL graph-native Claim ABox record",
  "type": "object",
  "required": ["@context", "iri", "id", "type", "subject", "predicate", "status", "provenance"],
  "properties": {
    "@context": {"type": "string", "minLength": 1},
    "iri": {"type": "string", "pattern": "^ex:CLAIM-[A-Z0-9-]+$"},
    "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$"},
    "type": {"const": "Claim"},
    "subject": {"type": "string", "pattern": "^ecl:[A-Z][A-Z0-9_-]*$"},
    "predicate": {"type": "string", "pattern": "^(ecl:[A-Za-z][A-Za-z0-9_-]*|https?://\\S+|urn:\\S+)$"},
    "object": {"type": "string", "pattern": "^ecl:[A-Z][A-Z0-9_-]*$"},
    "literalValue": {"type": ["string", "number", "integer", "boolean"]},
    "status": {"enum": ["candidate", "accepted", "disputed", "rejected", "superseded"]},
    "claimConfidence": {"enum": ["established", "well-supported", "reasonable-inference", "disputed", "insufficient", "rejected"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "asOf": {"type": "string", "format": "date"},
    "validFrom": {"type": "string", "format": "date"},
    "validTo": {"type": "string", "format": "date"},
    "evidenceFor": {"type": "array", "items": {"type": "string", "pattern": "^ecl:EVIDENCE-[A-Z0-9-]+$"}, "uniqueItems": true},
    "evidenceAgainst": {"type": "array", "items": {"type": "string", "pattern": "^ecl:EVIDENCE-[A-Z0-9-]+$"}, "uniqueItems": true},
    "supersedes": {"type": "string", "pattern": "^ex:CLAIM-[A-Z0-9-]+$"},
    "affectedVariables": {"type": "array", "items": {"enum": ["ex:P", "ex:A", "ex:V_ep", "ex:L", "ex:O", "ex:U", "ex:C", "ex:S", "ex:R", "ex:Ecol"]}, "uniqueItems": true},
    "affectedCriteria": {"type": "array", "items": {"enum": ["ecl:ECL5_1", "ecl:ECL5_2", "ecl:ECL5_3", "ecl:ECL5_4", "ecl:ECL5_5", "ecl:ECL5_6", "ecl:ECL5_7"]}, "uniqueItems": true},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "string"}
  },
  "oneOf": [
    {"required": ["object"], "not": {"required": ["literalValue"]}},
    {"required": ["literalValue"], "not": {"required": ["object"]}}
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]},
      "then": {"required": ["evidenceFor"], "properties": {"evidenceFor": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["candidate", "accepted", "disputed"]}}, "required": ["status"]},
      "then": {"anyOf": [
        {"required": ["evidenceFor"], "properties": {"evidenceFor": {"minItems": 1}}},
        {"required": ["evidenceAgainst"], "properties": {"evidenceAgainst": {"minItems": 1}}}
      ]}
    }
  ],
  "additionalProperties": false
}
