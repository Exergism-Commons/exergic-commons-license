{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exergism.org/ecl/schemas/exergic-assessment.schema.json",
  "title": "ECL Formal Exergism assessment",
  "type": "object",
  "required": ["assessment_id", "actor_id", "object", "scoring_status"],
  "properties": {
    "assessment_id": {"type": "string", "pattern": "^ECL-EX-[A-Z0-9-]+$"},
    "actor_id": {"type": "string", "pattern": "^(STATE|AGENCY|ORG|PERSON|INST)-[A-Z0-9-]+$"},
    "model": {"type": "string", "minLength": 1},
    "entity": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(STATE|AGENCY|ORG|PERSON|INST|PROJECT|DEPLOYMENT)-[A-Z0-9-]+$"}
    },
    "scoring_status": {"enum": ["scorable", "insufficient_evidence", "not_applicable"]},
    "reason": {"type": "string", "minLength": 1},
    "required_to_score": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "coverage_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "provenance"],
      "properties": {
        "status": {"enum": ["blocked", "disputed", "insufficient-evidence", "not-applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "normalization": {
      "type": "object",
      "required": ["method", "rubric", "anchors", "provenance"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "rubric": {"type": "string", "minLength": 1},
        "anchors": {"type": "object"},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^exergism/profiles/[A-Za-z0-9._-]+\\.json$"}
    },
    "sensitivity_review": {
      "type": "object",
      "required": ["performed", "notes"],
      "properties": {
        "performed": {"const": true},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "variables": {"type": "object"},
    "temporal": {"type": "object"},
    "temporal_applicability": {
      "type": "object",
      "required": ["status", "reason", "provenance"],
      "properties": {
        "status": {"const": "not-applicable"},
        "reason": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "adversarial_review": {
      "type": "object",
      "required": ["status", "determination", "reviewed_at", "reviewer_independence", "provenance"],
      "properties": {
        "status": {"const": "reviewed"},
        "determination": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"},
        "reviewer_independence": {"type": "string", "minLength": 1},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "criterion_relevance": {},
    "attribution": {},
    "counter_institutions": {},
    "exclusions": {},
    "disagreement_notes": {}
  },
  "allOf": [
    {
      "if": {"properties": {"scoring_status": {"const": "insufficient_evidence"}}, "required": ["scoring_status"]},
      "then": {"required": ["reason", "required_to_score"]}
    },
    {
      "if": {"properties": {"scoring_status": {"const": "not_applicable"}}, "required": ["scoring_status"]},
      "then": {"required": ["reason"]}
    }
  ],
  "additionalProperties": true
}
