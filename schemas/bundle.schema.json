{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecl:schema:bundle",
  "title": "Immutable ECL Bundle manifest",
  "type": "object",
  "required": ["schema_version", "bundle", "operative", "license", "schedule"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle": {"type": "string", "pattern": "^ECL-(?:[0-9]+\\.[0-9]+\\.[0-9]+@RP-(?:[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[0-9]+)?|EMPTY-[0-9]+)|[0-9]+\\.[0-9]+-DRAFT@RP-EMPTY-[0-9]+)$"},
    "operative": {"type": "boolean"},
    "license": {"$ref": "#/$defs/immutableComponent"},
    "schedule": {"$ref": "#/$defs/immutableComponent"},
    "legal_review": {"$ref": "#/$defs/legalReviewComponent"},
    "knowledge_snapshot": {"type": ["string", "null"]},
    "released_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"operative": {"const": true}},
        "required": ["operative"]
      },
      "then": {"required": ["legal_review"]}
    },
    {
      "if": {
        "properties": {"bundle": {"pattern": "@RP-EMPTY-[0-9]+$"}},
        "required": ["bundle"]
      },
      "then": {
        "properties": {
          "schedule": {
            "allOf": [
              {"$ref": "#/$defs/immutableComponent"},
              {"properties": {"ref": {"pattern": "^ECL-RP-EMPTY-[0-9]+$"}}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "immutableComponent": {
      "type": "object",
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "legalReviewComponent": {
      "type": "object",
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
        "path": {"type": "string", "pattern": "^reviews/legal/records/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
