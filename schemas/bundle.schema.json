{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ecl:schema:bundle",
  "title": "Immutable ECL Bundle manifest",
  "type": "object",
  "required": ["schema_version", "bundle", "operative", "license", "schedule"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle": {
      "type": "string",
      "pattern": "^(?:ECL-[0-9]+\\.[0-9]+\\.[0-9]+@RP-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(?:\\.[0-9]+)?|ECL-0\\.3-DRAFT@RP-EMPTY-1)$"
    },
    "operative": {"type": "boolean"},
    "license": {"$ref": "#/$defs/immutableComponent"},
    "schedule": {"$ref": "#/$defs/immutableComponent"},
    "legal_review": {"$ref": "#/$defs/legalReviewComponent"},
    "knowledge_snapshot": {"type": ["string", "null"]},
    "released_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"operative": {"const": true}},
        "required": ["operative"]
      },
      "then": {"required": ["legal_review"]}
    },
    {
      "if": {
        "properties": {"bundle": {"const": "ECL-0.3-DRAFT@RP-EMPTY-1"}},
        "required": ["bundle"]
      },
      "then": {
        "properties": {
          "operative": {"const": false},
          "license": {
            "allOf": [
              {"$ref": "#/$defs/immutableComponent"},
              {
                "properties": {
                  "ref": {"const": "ECL-0.3-DRAFT"},
                  "path": {"const": "versions/licenses/ECL-0.3-DRAFT.md"},
                  "sha256": {"const": "347a39d2e0b2a0df5bbe6c8b4bb0cc97b34f4866061d6be8522fe5f5578eb50d"}
                }
              }
            ]
          },
          "schedule": {
            "allOf": [
              {"$ref": "#/$defs/immutableComponent"},
              {
                "properties": {
                  "ref": {"const": "ECL-RP-EMPTY-1"},
                  "path": {"const": "schedules/ECL-RP-EMPTY-1.md"},
                  "sha256": {"const": "e12a6ffc03aa0be24a9f61d0d325bc8c06bb9c870416a72fcac0bfd968025aa2"}
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "immutableComponent": {
      "type": "object",
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "legalReviewComponent": {
      "type": "object",
      "required": ["ref", "path", "sha256"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"},
        "path": {"type": "string", "pattern": "^reviews/legal/records/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
