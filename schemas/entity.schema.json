{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ecl/schemas/entity.schema.json",
  "title": "ECL semantic entity record",
  "type": "object",
  "required": ["id", "type", "name", "dossier", "review"],
  "properties": {
    "@context": {"type": "string"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "type": {"enum": ["State", "Organization", "Person", "Agency", "Project", "Deployment", "Institution"]},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dossier": {"type": "string", "minLength": 1},
    "currentGovernance": {"enum": ["R", "S", "U", "N", "none"]},
    "review": {
      "type": "object",
      "required": ["lastSubstantiveReview", "nextReview"],
      "properties": {
        "lastSubstantiveReview": {"type": "string", "format": "date"},
        "nextReview": {"type": "string", "format": "date"},
        "reviewClass": {"enum": ["hot", "active", "stable", "manual"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "trackedObjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "monitorIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "object"],
        "properties": {
          "predicate": {"enum": ["controls", "participatesIn", "operates", "deploys", "materiallyBenefits", "targetsOrAffects", "remediates", "reviews"]},
          "object": {"type": "string"},
          "validFrom": {"type": ["string", "null"], "format": "date"},
          "validTo": {"type": ["string", "null"], "format": "date"},
          "claimIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
