@prefix ecl: <urn:ecl:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL defines repository/data validity. OWL defines semantics. These shapes do
# not create licensing restrictions and deliberately avoid score-to-tier rules.

ecl:TrackedObjectShape a sh:NodeShape ;
    sh:targetClass ecl:State, ecl:Organization, ecl:Person, ecl:Agency, ecl:Institution, ecl:Project, ecl:Deployment ;
    sh:property [
        sh:path ecl:stableId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][A-Z0-9-]+$"
    ] ;
    sh:property [
        sh:path ecl:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1
    ] ;
    sh:property [
        sh:path ecl:dossier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1
    ] .

# State identity/provenance is deliberately narrower than governance. A State
# actor must identify the dossier and public review surface, but may not carry a
# GovernanceOutcome or a governance/tier/restriction-status-like predicate.
ecl:StateShape a sh:NodeShape ;
    sh:targetClass ecl:State ;
    sh:property [
        sh:path ecl:stableId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^STATE-[A-Z]{3}$"
    ] ;
    sh:property [
        sh:path ecl:iso3 ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[A-Z]{3}$"
    ] ;
    sh:property [
        sh:path ecl:dossier ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^\\.\\./\\.\\./dossiers/states/[A-Z]{3}\\.md$"
    ] ;
    sh:property [
        sh:path ecl:publicReviewIssue ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path ecl:lastSubstantiveReview ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path ecl:reviewDue ;
        sh:maxCount 1 ; sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path ecl:reviewClass ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "hot" "active" "stable" "manual" )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Non-manual State review classes require an explicit reviewDue date." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:reviewClass ?class .
              FILTER (?class != "manual")
              FILTER NOT EXISTS { $this ecl:reviewDue ?due }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "State stableId, IRI, ISO3 and dossier path must describe the same ISO3." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:stableId ?id ; ecl:iso3 ?iso ; ecl:dossier ?dossier .
              FILTER (
                STR(?id) != CONCAT("STATE-", STR(?iso)) ||
                STR($this) != CONCAT("urn:ecl:STATE-", STR(?iso)) ||
                !STRENDS(STR(?dossier), CONCAT("/", STR(?iso), ".md"))
              )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Governance/tier/restriction status must never live directly on a State identity actor." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?p WHERE {
              $this ?p ?value .
              BIND(LCASE(STR(?p)) AS ?predicateText)
              BIND(REPLACE(?predicateText, "[^a-z0-9]+", "") AS ?normalizedPredicate)
              FILTER (
                ?p = ecl:outcome ||
                ?p = ecl:status ||
                CONTAINS(?normalizedPredicate, "currentgovernance") ||
                CONTAINS(?normalizedPredicate, "governancestatus") ||
                CONTAINS(?normalizedPredicate, "governanceoutcome") ||
                CONTAINS(?normalizedPredicate, "restrictionstatus") ||
                CONTAINS(?normalizedPredicate, "restrictedstatus") ||
                CONTAINS(?normalizedPredicate, "provisionaloutcome") ||
                REGEX(?predicateText, "(^|[:/#?&._-])tier([:/#?&._=-]|$)")
              )
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A State relationship must never point directly to a GovernanceOutcome." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?p ?value WHERE {
              $this ?p ?value .
              ?value a ecl:GovernanceOutcome .
            }
        """
    ] .

ecl:ReviewClockShape a sh:NodeShape ;
    sh:targetSubjectsOf ecl:reviewDue ;
    sh:property [ sh:path ecl:reviewDue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:lastSubstantiveReview ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [
        sh:path ecl:reviewClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "hot" "active" "stable" "manual" )
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "reviewDue must not predate lastSubstantiveReview." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:reviewDue ?due ; ecl:lastSubstantiveReview ?last .
              FILTER (?due < ?last)
            }
        """
    ] .

ecl:ClaimShape a sh:NodeShape ;
    sh:targetClass ecl:Claim ;
    sh:property [
        sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^CLAIM-[A-Z0-9-]+$"
    ] ;
    sh:property [ sh:path ecl:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ecl:predicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:xone (
        [ sh:property [ sh:path ecl:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path ecl:literalValue ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path ecl:literalValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
          sh:property [ sh:path ecl:object ; sh:maxCount 0 ] ]
    ) ;
    sh:property [
        sh:path ecl:status ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "candidate" "accepted" "disputed" "rejected" "superseded" )
    ] ;
    sh:property [
        sh:path ecl:claimConfidence ;
        sh:maxCount 1 ;
        sh:in ( "established" "well-supported" "reasonable-inference" "disputed" "insufficient" "rejected" )
    ] ;
    sh:property [ sh:path ecl:observedAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ecl:asOf ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:validFrom ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:validTo ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:evidenceFor ; sh:class ecl:EvidenceItem ] ;
    sh:property [ sh:path ecl:evidenceAgainst ; sh:class ecl:EvidenceItem ] ;
    sh:property [ sh:path ecl:supersedes ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ecl:Claim ] ;
    sh:property [ sh:path ecl:provenance ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim stableId and IRI must identify the same Claim." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:stableId ?id .
              FILTER (STR($this) != CONCAT("urn:ecl:", STR(?id)))
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Active candidate/accepted/disputed Claims require an evidence link." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:status ?status .
              FILTER (?status IN ("candidate", "accepted", "disputed"))
              FILTER NOT EXISTS { $this ecl:evidenceFor ?support }
              FILTER NOT EXISTS { $this ecl:evidenceAgainst ?contrary }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Accepted Claims require an existing supporting EvidenceItem identity." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:status "accepted" .
              FILTER NOT EXISTS {
                $this ecl:evidenceFor ?evidence .
                ?evidence a ecl:EvidenceItem ; ecl:stableId ?evidenceId .
              }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim evidence links must resolve to EvidenceItem identities." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?evidence WHERE {
              { $this ecl:evidenceFor ?evidence }
              UNION
              { $this ecl:evidenceAgainst ?evidence }
              FILTER NOT EXISTS { ?evidence ecl:stableId ?evidenceId }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim supersedes must resolve to a Claim identity." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?target WHERE {
              $this ecl:supersedes ?target .
              FILTER NOT EXISTS {
                ?target a ecl:Claim ; ecl:stableId ?targetId .
              }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Internal Claim subjects and IRI objects must resolve to ABox identities." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?target WHERE {
              {
                $this ecl:subject ?target .
              } UNION {
                $this ecl:object ?target .
              }
              FILTER (STRSTARTS(STR(?target), "urn:ecl:"))
              FILTER NOT EXISTS { ?target ecl:stableId ?targetId }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim validity interval is inverted." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:validFrom ?from ; ecl:validTo ?to .
              FILTER (?to < ?from)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Claim nodes may not encode governance/tier/restriction outcomes as their asserted predicate or object." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?predicate ?object WHERE {
              $this ecl:predicate ?predicate .
              OPTIONAL { $this ecl:object ?object }
              BIND(LCASE(STR(?predicate)) AS ?predicateText)
              BIND(REPLACE(?predicateText, "[^a-z0-9]+", "") AS ?normalizedPredicate)
              FILTER (
                ?predicate = ecl:outcome ||
                CONTAINS(?normalizedPredicate, "currentgovernance") ||
                CONTAINS(?normalizedPredicate, "governancestatus") ||
                CONTAINS(?normalizedPredicate, "governanceoutcome") ||
                CONTAINS(?normalizedPredicate, "restrictionstatus") ||
                CONTAINS(?normalizedPredicate, "restrictedstatus") ||
                CONTAINS(?normalizedPredicate, "provisionaloutcome") ||
                REGEX(?predicateText, "(^|[:/#?&._-])tier([:/#?&._=-]|$)") ||
                (BOUND(?object) && EXISTS { ?object a ecl:GovernanceOutcome })
              )
            }
        """
    ] .

ecl:EvidenceItemShape a sh:NodeShape ;
    sh:targetClass ecl:EvidenceItem ;
    sh:property [
        sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^EVIDENCE-[A-Z0-9-]+$"
    ] ;
    sh:property [ sh:path ecl:sourceLocator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ecl:provenance ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [
        sh:path ecl:evidenceGrade ;
        sh:maxCount 1 ;
        sh:in ( "E0" "E1" "E2" "E3" )
    ] ;
    sh:property [ sh:path ecl:publicationDate ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:retrievedAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path ecl:supersedes ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ecl:EvidenceItem ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "EvidenceItem stableId and IRI must identify the same EvidenceItem." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:stableId ?id .
              FILTER (STR($this) != CONCAT("urn:ecl:", STR(?id)))
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "EvidenceItem supersedes must resolve to an EvidenceItem identity." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this ?target WHERE {
              $this ecl:supersedes ?target .
              FILTER NOT EXISTS {
                ?target a ecl:EvidenceItem ; ecl:stableId ?targetId .
              }
            }
        """
    ] .

ecl:AssessmentShape a sh:NodeShape ;
    sh:targetClass ecl:ExergicAssessment ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

ecl:GovernanceDecisionShape a sh:NodeShape ;
    sh:targetClass ecl:GovernanceDecision ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ecl:outcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ecl:GovernanceOutcome ] ;
    sh:property [ sh:path ecl:rationale ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

ecl:UpdateCaseShape a sh:NodeShape ;
    sh:targetClass ecl:UpdateCase ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ecl:fingerprint ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path ecl:priority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "P0" "P1" "P2" "P3" "P4" )
    ] .

# -----------------------------------------------------------------------------
# Immutable snapshot/release/bundle shapes
# -----------------------------------------------------------------------------

ecl:KnowledgeSnapshotShape a sh:NodeShape ;
    sh:targetClass ecl:KnowledgeSnapshot ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:gitCommit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path ecl:aboxSourceSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path ecl:ontologySha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path ecl:evidenceCutoff ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ecl:createdAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

ecl:LicenseReleaseShape a sh:NodeShape ;
    sh:targetClass ecl:LicenseRelease ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:releaseVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:artifactPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

ecl:ScheduleReleaseShape a sh:NodeShape ;
    sh:targetClass ecl:ScheduleRelease ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:releaseVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:artifactPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path ecl:capturesKnowledge ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ecl:KnowledgeSnapshot ] .

ecl:ECLBundleShape a sh:NodeShape ;
    sh:targetClass ecl:ECLBundle ;
    sh:property [ sh:path ecl:stableId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ecl:usesLicenseRelease ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ecl:LicenseRelease ] ;
    sh:property [ sh:path ecl:usesScheduleRelease ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ecl:ScheduleRelease ] ;
    sh:property [ sh:path ecl:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path ecl:operative ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

# Global stable-ID uniqueness. This is a repository invariant, not an OWL
# identity axiom, so an accidental duplicate fails CI rather than silently
# merging two real-world entities.
ecl:StableIdUniquenessShape a sh:NodeShape ;
    sh:targetSubjectsOf ecl:stableId ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ecl:stableId must be globally unique." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              $this ecl:stableId ?id .
              ?other ecl:stableId ?id .
              FILTER (?other != $this)
            }
        """
    ] .

# State-specific uniqueness is structural repository validity, not OWL identity.
ecl:StateMappingUniquenessShape a sh:NodeShape ;
    sh:targetClass ecl:State ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "State ISO3 and dossier mappings must be one-to-one among State actors." ;
        sh:select """
            PREFIX ecl: <urn:ecl:>
            SELECT $this WHERE {
              {
                $this ecl:iso3 ?v .
                ?other a ecl:State ; ecl:iso3 ?v .
                FILTER (?other != $this)
              } UNION {
                $this ecl:dossier ?v .
                ?other a ecl:State ; ecl:dossier ?v .
                FILTER (?other != $this)
              }
            }
        """
    ] .
