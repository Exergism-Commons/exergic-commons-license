@prefix ec: <https://id.exergism.org/commons#> .
@prefix ecg: <https://id.exergism.org/governance#> .
@prefix ex: <https://id.exergism.org/exergism#> .
@prefix ecl: <https://id.exergism.org/ecl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://id.exergism.org/ontology/ecl> a owl:Ontology ;
    rdfs:label "Exergic Commons License knowledge ontology"@en ;
    owl:versionInfo "0.2.0-pre1" ;
    owl:imports <https://id.exergism.org/ontology/commons>,
                <https://id.exergism.org/ontology/governance>,
                <https://id.exergism.org/ontology/exergism> ;
    rdfs:comment "TBox for ECL knowledge, evidence, analysis, governance specialization and immutable release/bundle records. Shared actor/identity/provenance primitives are reused from Commons, institutional decision semantics from Governance, and canonical exergic variables from Exergism. It does not itself create licensing restrictions."@en .

# -----------------------------------------------------------------------------
# ECL tracked subjects
# -----------------------------------------------------------------------------

ecl:TrackedObject a owl:Class .
ex:State a owl:Class ;
    rdfs:subClassOf ec:Actor, ecl:TrackedObject .
ex:Agency a owl:Class ;
    rdfs:subClassOf ec:Organization, ecl:TrackedObject .
ecl:Institution a owl:Class ;
    rdfs:subClassOf ec:Organization, ecl:TrackedObject .
ex:Project a owl:Class ; rdfs:subClassOf ecl:TrackedObject .
ecl:Deployment a owl:Class ; rdfs:subClassOf ecl:TrackedObject .

# Generic Person and Organization identities are intentionally not redefined in
# ecl#. ECL records may type a subject as ec:Person or ec:Organization directly.

# -----------------------------------------------------------------------------
# Evidence, analysis and ECL governance specialization
# -----------------------------------------------------------------------------

ecl:EvidenceItem a owl:Class ; rdfs:subClassOf ec:EvidenceRecord .
ex:Claim a owl:Class .
ecl:ExergicAssessment a owl:Class .
ecl:ECLGovernanceDecision a owl:Class ; rdfs:subClassOf ecg:GovernanceDecision .
ex:UpdateSignal a owl:Class .
ex:UpdateCase a owl:Class .
ecl:KnowledgeSnapshot a owl:Class ; rdfs:subClassOf ec:Artifact .
ex:ScheduleEntry a owl:Class .

# -----------------------------------------------------------------------------
# Immutable release/versioning model
# -----------------------------------------------------------------------------

ex:LicenseRelease a owl:Class ; rdfs:subClassOf ec:ReleaseArtifact .
ex:ScheduleRelease a owl:Class ; rdfs:subClassOf ec:ReleaseArtifact .
ecl:ECLBundle a owl:Class ; rdfs:subClassOf ec:ReleaseArtifact .

# -----------------------------------------------------------------------------
# ECL-specific analytical/governance concepts
# -----------------------------------------------------------------------------

ecl:ECLCriterion a owl:Class .
ecl:GovernanceOutcome a owl:Class .

ecl:ECL5_1 a ecl:ECLCriterion ; rdfs:label "ECL 5.1 Repressive surveillance"@en .
ecl:ECL5_2 a ecl:ECLCriterion ; rdfs:label "ECL 5.2 Coercive targeting"@en .
ecl:ECL5_3 a ecl:ECLCriterion ; rdfs:label "ECL 5.3 Systematic discriminatory domination"@en .
ecl:ECL5_4 a ecl:ECLCriterion ; rdfs:label "ECL 5.4 Deceptive population manipulation"@en .
ecl:ECL5_5 a ecl:ECLCriterion ; rdfs:label "ECL 5.5 Irreversible coercive capture"@en .
ecl:ECL5_6 a ecl:ECLCriterion ; rdfs:label "ECL 5.6 Systematic coercive domination and unlawful political repression"@en .
ecl:ECL5_7 a ecl:ECLCriterion ; rdfs:label "ECL 5.7 Circumvention"@en .

ex:OutcomeR a ecl:GovernanceOutcome ; rdfs:label "Restricted"@en .
ex:OutcomeS a ecl:GovernanceOutcome ; rdfs:label "Scoped restriction"@en .
ex:OutcomeU a ecl:GovernanceOutcome ; rdfs:label "Under review / insufficient basis"@en .
ex:OutcomeN a ecl:GovernanceOutcome ; rdfs:label "No current ECL-relevant basis"@en .

# Exergic variables are NOT redefined here. ECL references the canonical
# Exergism terms ex:P, ex:A, ex:V_ep, ex:L, ex:O, ex:U, ex:C, ex:S, ex:R and
# ex:Ecol when the same formal variables are intended.

# -----------------------------------------------------------------------------
# ECL-specific identity/evidence metadata
# -----------------------------------------------------------------------------

ecl:name a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:alias a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:iso3 a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ex:State ; rdfs:range xsd:string .
ecl:dossier a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:monitorId a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:fingerprint a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:priority a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:validFrom a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:validTo a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:asOf a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:observedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
ecl:publicationDate a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:retrievedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
ecl:evidenceGrade a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .
ecl:claimConfidence a owl:DatatypeProperty ; rdfs:domain ex:Claim ; rdfs:range xsd:string .
ecl:lastSubstantiveReview a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:reviewClass a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:reviewReason a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:literalValue a owl:DatatypeProperty ; rdfs:domain ex:Claim .
ecl:sourceLocator a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .
ecl:publisher a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .
ecl:sourceType a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .
ecl:language a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .
ecl:contentHash a owl:DatatypeProperty ; rdfs:domain ecl:EvidenceItem ; rdfs:range xsd:string .

# -----------------------------------------------------------------------------
# Graph relationships
# -----------------------------------------------------------------------------

ecl:subject a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( ex:Claim ecl:ExergicAssessment ecl:ECLGovernanceDecision ex:UpdateCase ) ] .

ecl:predicate a owl:ObjectProperty ; rdfs:domain ex:Claim .
ecl:object a owl:ObjectProperty ; rdfs:domain ex:Claim .

ecl:publicReviewIssue a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain ex:State ;
    rdfs:range owl:Thing ;
    rdfs:comment "Public GitHub review surface for a State dossier. It is provenance/review metadata, not a governance database."@en .

ecl:tracks a owl:ObjectProperty ;
    rdfs:range owl:Thing ;
    rdfs:comment "Explicitly curated tracking dependency. Tracking creates review relevance only, never inherited restriction."@en .

ecl:partOf a owl:ObjectProperty ;
    rdfs:domain ec:Actor ;
    rdfs:range ec:Actor ;
    rdfs:comment "Directly curated institutional containment. Only the asserted parent edge is semantic; no transitive, operational, culpability or governance inheritance is implied."@en .

ecl:controls a owl:ObjectProperty ; rdfs:domain ec:Actor ; rdfs:range ec:Actor .
ecl:controlledBy a owl:ObjectProperty ; owl:inverseOf ecl:controls ; rdfs:domain ec:Actor ; rdfs:range ec:Actor .
ecl:participatesIn a owl:ObjectProperty ; rdfs:domain ec:Actor ; rdfs:range ex:Project .
ecl:operates a owl:ObjectProperty ; rdfs:domain ec:Actor ; rdfs:range owl:Thing .
ecl:deploys a owl:ObjectProperty ; rdfs:domain ec:Actor ; rdfs:range ecl:Deployment .
ecl:materiallyBenefits a owl:ObjectProperty ; rdfs:domain ec:Actor ; rdfs:range owl:Thing .
ecl:targetsOrAffects a owl:ObjectProperty ; rdfs:range owl:Thing .
ecl:remediates a owl:ObjectProperty ; rdfs:domain ecl:Institution ; rdfs:range owl:Thing .
ecl:reviews a owl:ObjectProperty ; rdfs:domain ecl:Institution ; rdfs:range owl:Thing .

ecl:evidenceFor a owl:ObjectProperty ; rdfs:domain ex:Claim ; rdfs:range ecl:EvidenceItem .
ecl:evidenceAgainst a owl:ObjectProperty ; rdfs:domain ex:Claim ; rdfs:range ecl:EvidenceItem .
ecl:dependsOnClaim a owl:ObjectProperty ; rdfs:domain ecl:ExergicAssessment ; rdfs:range ex:Claim .
ecl:hasAssessment a owl:ObjectProperty ; rdfs:range ecl:ExergicAssessment .
ecl:hasDecision a owl:ObjectProperty ; rdfs:range ecl:ECLGovernanceDecision .
ecl:triggersReviewOf a owl:ObjectProperty ; rdfs:range owl:Thing .
ecl:affectedVariable a owl:ObjectProperty ;
    rdfs:range owl:Thing ;
    rdfs:comment "References canonical Exergism variables when those variables are intended; ECL does not own their definitions."@en .
ecl:affectedCriterion a owl:ObjectProperty ; rdfs:range ecl:ECLCriterion .
ecl:outcome a owl:ObjectProperty ; rdfs:domain ecl:ECLGovernanceDecision ; rdfs:range ecl:GovernanceOutcome .
ecl:basedOnAssessment a owl:ObjectProperty ; rdfs:domain ecl:ECLGovernanceDecision ; rdfs:range ecl:ExergicAssessment .

# -----------------------------------------------------------------------------
# Immutable release/versioning metadata and relationships
# -----------------------------------------------------------------------------

ecl:gitCommit a owl:DatatypeProperty ; rdfs:domain ecl:KnowledgeSnapshot ; rdfs:range xsd:string .
ecl:aboxSourceSha256 a owl:DatatypeProperty ; rdfs:domain ecl:KnowledgeSnapshot ; rdfs:range xsd:string .
ecl:ontologySha256 a owl:DatatypeProperty ; rdfs:domain ecl:KnowledgeSnapshot ; rdfs:range xsd:string .
ecl:evidenceCutoff a owl:DatatypeProperty ; rdfs:domain ecl:KnowledgeSnapshot ; rdfs:range xsd:date .
ecl:createdAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
ecl:releaseVersion a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:releaseDate a owl:DatatypeProperty ; rdfs:range xsd:date .
ecl:artifactPath a owl:DatatypeProperty ; rdfs:range xsd:string .
ecl:channel a owl:DatatypeProperty ; rdfs:range xsd:string .

ecl:capturesKnowledge a owl:ObjectProperty ; rdfs:domain ex:ScheduleRelease ; rdfs:range ecl:KnowledgeSnapshot .
ecl:containsScheduleEntry a owl:ObjectProperty ; rdfs:domain ex:ScheduleRelease ; rdfs:range ex:ScheduleEntry .
ecl:basedOnDecision a owl:ObjectProperty ; rdfs:domain ex:ScheduleEntry ; rdfs:range ecl:ECLGovernanceDecision .
ecl:usesLicenseRelease a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ecl:ECLBundle ; rdfs:range ex:LicenseRelease .
ecl:usesScheduleRelease a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ecl:ECLBundle ; rdfs:range ex:ScheduleRelease .
ecl:previousRelease a owl:ObjectProperty ; rdfs:domain ec:ReleaseArtifact ; rdfs:range ec:ReleaseArtifact .

# Deliberate ownership boundary:
# - ecl# does not define Actor, Person, Organization, stableId, title, status,
#   rationale, provenance, supersedes, reviewDue, operative or sha256;
# - ecl# does not define the canonical Exergism variables;
# - ECLGovernanceDecision specializes governance#GovernanceDecision rather than
#   creating a parallel generic governance root.
#
# Deliberate non-axioms / reasoning boundary:
# - Claim nodes record reviewed propositions; they do not materialize their predicate as a direct subject triple;
# - no owl:propertyChainAxiom is used for actor relationships;
# - partOf is direct institutional context only: it is not transitive and does NOT entail controls, participatesIn, operates, tracks or governance;
# - controls o participatesIn does NOT entail participatesIn;
# - association with a Restricted actor does NOT infer a GovernanceOutcome;
# - tracks is review/provenance metadata and does NOT infer participation or status;
# - Exergism scores do NOT infer OutcomeR/OutcomeS/OutcomeU/OutcomeN;
# - graph reachability may trigger review in tooling, never inherited restriction.
