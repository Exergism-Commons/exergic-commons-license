PREFIX ecl: <urn:ecl:>

SELECT ?state ?id ?iso ?dossier WHERE {
  ?state a ecl:State ;
         ecl:stableId ?id ;
         ecl:iso3 ?iso ;
         ecl:dossier ?dossier .
  FILTER (
    STR(?id) != CONCAT("STATE-", STR(?iso)) ||
    STR(?state) != CONCAT("urn:ecl:STATE-", STR(?iso)) ||
    !STRENDS(STR(?dossier), CONCAT("/", STR(?iso), ".md"))
  )
}
