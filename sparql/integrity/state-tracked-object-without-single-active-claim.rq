PREFIX ec: <https://id.exergism.org/commons#>
PREFIX ex: <https://id.exergism.org/exergism#>
PREFIX ecl: <https://id.exergism.org/ecl#>

SELECT ?state ?project (COUNT(?claim) AS ?activeClaimCount) WHERE {
  ?state a ex:State ;
         ecl:tracks ?project .

  OPTIONAL {
    ?claim a ex:Claim ;
           ecl:subject ?state ;
           ecl:predicate ecl:tracks ;
           ecl:object ?project ;
           ec:status ?claimStatus .
    FILTER (?claimStatus IN ("candidate", "accepted", "disputed"))
  }
}
GROUP BY ?state ?project
HAVING (COUNT(?claim) != 1)
