PREFIX ec: <https://id.exergism.org/commons#>
PREFIX ex: <https://id.exergism.org/exergism#>
PREFIX ecl: <https://id.exergism.org/ecl#>

SELECT ?kind ?value ?count WHERE {
  {
    SELECT ("iso3" AS ?kind) ?value (COUNT(DISTINCT ?state) AS ?count) WHERE {
      ?state a ex:State ; ecl:iso3 ?value .
    }
    GROUP BY ?value
    HAVING (COUNT(DISTINCT ?state) != 1)
  }
  UNION
  {
    SELECT ("dossier" AS ?kind) ?value (COUNT(DISTINCT ?state) AS ?count) WHERE {
      ?state a ex:State ; ecl:dossier ?value .
    }
    GROUP BY ?value
    HAVING (COUNT(DISTINCT ?state) != 1)
  }
  UNION
  {
    SELECT ("stableId" AS ?kind) ?value (COUNT(DISTINCT ?state) AS ?count) WHERE {
      ?state a ex:State ; ec:stableId ?value .
    }
    GROUP BY ?value
    HAVING (COUNT(DISTINCT ?state) != 1)
  }
}
