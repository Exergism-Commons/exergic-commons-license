PREFIX ec: <https://id.exergism.org/commons#>
PREFIX ex: <https://id.exergism.org/exergism#>
PREFIX ecl: <https://id.exergism.org/ecl#>

SELECT ?left ?right ?subject ?predicate
WHERE {
  # Accepted-value conflicts are meaningful only for predicates whose values are
  # explicitly curated as mutually exclusive/single-valued. Relationship
  # predicates such as tracks/controls/deploys are intentionally multi-valued.
  VALUES ?predicate { ec:status }

  ?left a ex:Claim ;
        ecl:subject ?subject ;
        ecl:predicate ?predicate ;
        ec:status "accepted" .
  ?right a ex:Claim ;
         ecl:subject ?subject ;
         ecl:predicate ?predicate ;
         ec:status "accepted" .
  FILTER (STR(?left) < STR(?right))

  OPTIONAL { ?left ecl:object ?leftObject . }
  OPTIONAL { ?left ecl:literalValue ?leftLiteral . }
  OPTIONAL { ?right ecl:object ?rightObject . }
  OPTIONAL { ?right ecl:literalValue ?rightLiteral . }
  BIND(COALESCE(?leftObject, ?leftLiteral) AS ?leftValue)
  BIND(COALESCE(?rightObject, ?rightLiteral) AS ?rightValue)
  FILTER (!sameTerm(?leftValue, ?rightValue))

  OPTIONAL { ?left ecl:validFrom ?leftFrom . }
  OPTIONAL { ?left ecl:validTo ?leftTo . }
  OPTIONAL { ?right ecl:validFrom ?rightFrom . }
  OPTIONAL { ?right ecl:validTo ?rightTo . }
  FILTER (!(BOUND(?leftTo) && BOUND(?rightFrom) && ?leftTo < ?rightFrom))
  FILTER (!(BOUND(?rightTo) && BOUND(?leftFrom) && ?rightTo < ?leftFrom))

  FILTER NOT EXISTS { ?left ec:supersedes ?right . }
  FILTER NOT EXISTS { ?right ec:supersedes ?left . }
}
