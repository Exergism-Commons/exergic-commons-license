PREFIX ecl: <urn:ecl:>

SELECT ?record ?problem WHERE {
  {
    ?record a ecl:GovernanceDecision ; ecl:outcome ?outcome .
    FILTER (?outcome IN (ecl:R, ecl:S))
    FILTER NOT EXISTS { ?record ecl:basedOnAssessment ?assessment }
    BIND("material GovernanceDecision lacks basedOnAssessment" AS ?problem)
  }
  UNION
  {
    ?record a ecl:ScheduleEntry .
    FILTER NOT EXISTS { ?record ecl:basedOnDecision ?decision }
    BIND("ScheduleEntry lacks basedOnDecision" AS ?problem)
  }
}
