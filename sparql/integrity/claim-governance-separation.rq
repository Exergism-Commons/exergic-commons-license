PREFIX ecl: <urn:ecl:>

SELECT ?claim ?predicate ?object
WHERE {
  ?claim a ecl:Claim ; ecl:predicate ?predicate .
  OPTIONAL { ?claim ecl:object ?object . }

  # Normalize the complete predicate IRI instead of discarding path segments.
  # This catches equivalent spellings such as governance__status,
  # governance-status-code, and https://host/governance/status.
  BIND(LCASE(STR(?predicate)) AS ?predicateText)
  BIND(REPLACE(?predicateText, "[^a-z0-9]+", "") AS ?normalizedPredicate)

  FILTER (
    ?predicate = ecl:outcome ||
    CONTAINS(?normalizedPredicate, "currentgovernance") ||
    CONTAINS(?normalizedPredicate, "governancestatus") ||
    CONTAINS(?normalizedPredicate, "governanceoutcome") ||
    CONTAINS(?normalizedPredicate, "restrictionstatus") ||
    CONTAINS(?normalizedPredicate, "restrictedstatus") ||
    CONTAINS(?normalizedPredicate, "provisionaloutcome") ||
    REGEX(?predicateText, "(^|[:/#?&._-])tier([:/#?&._=-]|$)") ||
    (BOUND(?object) && EXISTS { ?object a ecl:GovernanceOutcome })
  )
}
