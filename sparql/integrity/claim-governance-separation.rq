PREFIX ex: <https://id.exergism.org/exergism#>
PREFIX ecl: <https://id.exergism.org/ecl#>

SELECT ?claim ?predicate ?object
WHERE {
  ?claim a ex:Claim ; ecl:predicate ?predicate .
  OPTIONAL { ?claim ecl:object ?object . }

  # Normalize the semantic predicate IRI/path instead of only the final local
  # name. For HTTP(S), strip scheme+authority only up to /, ? or # so semantic
  # query/fragment content remains visible while hostname text stays excluded.
  # Keep tier token-aware so "frontier" stays valid.
  BIND(LCASE(STR(?predicate)) AS ?predicateText)
  BIND(REPLACE(?predicateText, "^[a-z][a-z0-9+.-]*://[^/?#]*", "") AS ?semanticPart)
  BIND(REPLACE(?semanticPart, "[^a-z0-9]+", "") AS ?normalizedSemantic)

  FILTER (
    ?predicate = ecl:outcome ||
    CONTAINS(?normalizedSemantic, "currentgovernance") ||
    CONTAINS(?normalizedSemantic, "governancestatus") ||
    CONTAINS(?normalizedSemantic, "governanceoutcome") ||
    CONTAINS(?normalizedSemantic, "restrictionstatus") ||
    CONTAINS(?normalizedSemantic, "restrictedstatus") ||
    CONTAINS(?normalizedSemantic, "provisionaloutcome") ||
    REGEX(?semanticPart, "(^|[^a-z0-9])tier([a-z0-9]*)([^a-z0-9]|$)") ||
    (BOUND(?object) && EXISTS { ?object a ecl:GovernanceOutcome })
  )
}
