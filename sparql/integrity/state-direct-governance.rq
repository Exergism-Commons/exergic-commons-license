PREFIX ecl: <urn:ecl:>

SELECT ?state ?predicate ?value WHERE {
  ?state a ecl:State ; ?predicate ?value .
  FILTER (
    ?predicate = ecl:outcome ||
    REGEX(
      STR(?predicate),
      "(current.?governance|governance.?(status|outcome)|restriction.?status|restricted.?status|tier|provisional.?outcome)$",
      "i"
    )
  )
}
